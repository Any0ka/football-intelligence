# AI assistant of the app (python -m app.server). Copy to .env and put your key there; .env is never committed.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium      # low / medium / high: depth of reasoning and cost per answer
# FI_WEB_SEARCH=1              # 0 turns off web search for questions outside the data
# FI_AI_DAILY=300              # questions per day from everyone (matters when the page is public via a tunnel)
